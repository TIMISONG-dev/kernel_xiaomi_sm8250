# Local Version
CONFIG_LOCALVERSION="-MagicTime"
CONFIG_LOCALVERSION_AUTO=y

# PELT
CONFIG_PELT_COMPATIBILITY_LAYER=y
CONFIG_SCHED_THERMAL_PRESSURE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_ASSIST=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_SCHED_CASS=y
CONFIG_RT_SOFTIRQ_AWARE_SCHED=y
CONFIG_RCU_PANIC_ON_STALL=1

# ZRAM
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_WRITEBACK=y

# TEO
CONFIG_CPU_IDLE_GOV_TEO=y

# Memory
CONFIG_USERFAULTFD=y
CONFIG_CMA_AREAS=32
CONFIG_PRIORITIZE_OOM_TASKS=y

# BPF
CONFIG_FAKE_UNAME_5_15=y

# ION
CONFIG_ION_SYSTEM_HEAP=y

# NET
CONFIG_CNSS_QCA6390=y
CONFIG_NET_ACT_NAT=y
CONFIG_NET_ACT_PEDIT=y
CONFIG_NET_ACT_CSUM=y
# CONFIG_WIL6210 is not set
# CONFIG_MSM_11AD is not set
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_FQ_CODEL=y

# Module
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n

# CPUSETs
CONFIG_CPUSET_ASSIST=y
CONFIG_CPUSET_AUDIO_APP="0-3"
CONFIG_CPUSET_DISPLAY="0-7"
CONFIG_FG="0-6"
CONFIG_CPUSET_RESTRICTED="0-3"

# KernelSU
CONFIG_KSU=y

# USB
CONFIG_USB_MASS_STORAGE=y

# MIUI
CONFIG_RTMM=y
CONFIG_MIHW=y
CONFIG_MILLET_CGROUP=y
CONFIG_MILLET_SIG=y
CONFIG_MILLET_BINDER=y
CONFIG_MILLET_PKG=y
CONFIG_MILLET_BINDER_GKI=y
CONFIG_MILLET_CORE=y
CONFIG_MILLET_HS=y
CONFIG_BINDER_PRIO=y
