# Local Version
CONFIG_LOCALVERSION="-MagicTime"
CONFIG_LOCALVERSION_AUTO=y

# BPF
CONFIG_FAKE_UNAME_5_15=y

# NET
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y

# CPUSETs
CONFIG_CPUSET_ASSIST=y
CONFIG_CPUSET_BG="0-3"
CONFIG_CPUSET_CAMERA="0-7"
CONFIG_CPUSET_FG="0-6"
CONFIG_CPUSET_RESTRICTED="0-3"
CONFIG_CPUSET_SYSTEM_BG="0-3"
CONFIG_CPUSET_TOP_APP="0-7"

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y

# USB
CONFIG_USB_MASS_STORAGE=m

# NTSYNC
CONFIG_NTSYNC=y

# Droidspace
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_DEVTMPFS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
