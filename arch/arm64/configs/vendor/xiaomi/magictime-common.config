# Local Version
CONFIG_LOCALVERSION="-MagicTime"
CONFIG_LOCALVERSION_AUTO=y

# PELT
# CONFIG_FAIR_GROUP_SCHED is not set

# RCU
CONFIG_RCU_BOOST=y

# TEO
CONFIG_CPU_IDLE_GOV_TEO=y

# BPF
CONFIG_FAKE_UNAME_5_15=y

# NET
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# CPUSETs
CONFIG_CPUSET_ASSIST=n
CONFIG_CPUSET_BG="0-3"
CONFIG_CPUSET_CAMERA="0-7"
CONFIG_CPUSET_FG="0-6"
CONFIG_CPUSET_RESTRICTED="0-3"
CONFIG_CPUSET_SYSTEM_BG="0-3"
CONFIG_CPUSET_TOP_APP="0-7"

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y

# CPU tuning
CONFIG_ARM64_TUNE_SM8250=y

# USB
CONFIG_USB_MASS_STORAGE=m

# NTSYNC
CONFIG_NTSYNC=y

# Droidspace
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_DEVTMPFS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# MIUI
CONFIG_XIAOMI_MIUI=y
CONFIG_RTMM=y
CONFIG_BINDER_OPT=y
CONFIG_MIGT=y
CONFIG_MILLET=y
CONFIG_MIGT_ENERGY_MODEL=y
CONFIG_PERF_HUMANTASK=y
CONFIG_PERF_CRITICAL_RT_TASK=y
CONFIG_SF_BINDER=y
