# Local Version
CONFIG_LOCALVERSION="-MagicTime"
CONFIG_LOCALVERSION_AUTO=y

# PELT
CONFIG_PELT_COMPATIBILITY_LAYER=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_ASSIST=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20

# RCU
CONFIG_RCU_BOOST=y
CONFIG_RCU_LAZY=y

# TEO
CONFIG_CPU_IDLE_GOV_TEO=y

# CRYPTO
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y

# ZRAM
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# BPF
CONFIG_FAKE_UNAME_5_15=y

# NET
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y

# CPUSETs
CONFIG_CPUSET_ASSIST=n
CONFIG_CPUSET_BG="0-3"
CONFIG_CPUSET_CAMERA="0-7"
CONFIG_CPUSET_FG="0-6"
CONFIG_CPUSET_RESTRICTED="0-3"
CONFIG_CPUSET_SYSTEM_BG="0-3"
CONFIG_CPUSET_TOP_APP="0-7"

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y

# USB
CONFIG_USB_MASS_STORAGE=m

# NTSYNC
CONFIG_NTSYNC=y

# Droidspace
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_DEVTMPFS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# MIUI
CONFIG_RTMM=y
